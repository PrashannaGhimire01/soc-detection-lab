# Suricata custom rules (WEB01)

alert icmp any any -> $HOME_NET any (msg:"LAB Ping (ICMP) to internal host"; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LAB Possible port scan (SYN flood)"; flags:S; threshold:type both, track by_src, count 15, seconds 10; sid:1000002; rev:2;)
pass tcp 10.10.10.10 any -> $HOME_NET any (msg:"Allowlist SIEM01 management traffic"; sid:1000099; rev:1;)
