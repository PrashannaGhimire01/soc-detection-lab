<!--
  Himal Traders custom detection rules.
  Deploy on SIEM01 at: /var/ossec/etc/rules/local_rules.xml
  Custom rule IDs must be 100000-120000.
  Test with: /var/ossec/bin/wazuh-logtest
  Apply with: systemctl restart wazuh-manager
-->

<group name="himaltraders,windows,">

  <!--
    Detection #1 - Windows failed logons / brute force (4625)
    Threat model: Path 1 step 1 (ransomware via RDP). ATT&CK T1110.001.
    Wazuh decodes Windows 4625 into data.win.system.eventID = 4625.
    Rule 60122 is the built-in "Logon failure" rule for 4625; we build on it
    with if_sid so our rule only evaluates real 4625 events.
  -->

  <!-- Base: flag any single Windows failed logon from our environment (low level) -->
  <rule id="100001" level="3">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <description>HimalTraders: Windows failed logon (4625) for user $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,himaltraders_bruteforce,</group>
  </rule>

  <!-- Correlation: 8+ failed logons within 120s against the same user = brute force (high level).
       Grouping by targeted user (not source IP) so it also catches local credential attacks,
       where a source IP may be absent. -->
  <rule id="100002" level="12" frequency="8" timeframe="120">
    <if_matched_sid>100001</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>HimalTraders: Possible brute force - 8+ Windows failed logons in 2 min for same user (T1110.001)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,himaltraders_bruteforce,pci_dss_11.4,</group>
  </rule>

  <!--
    Detection #5 - New account created / added to a privileged group
    Threat model: Path 1 step 4 (backdoor admin account). ATT&CK T1136 + T1098.
    Built-in Wazuh rules already flag these; we raise severity and tag them for
    Himal Traders so they stand out and map to our coverage.
  -->

  <!-- A new user account was created (4720) -->
  <rule id="100005" level="8">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^4720$</field>
    <description>HimalTraders: New user account created: $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName) (T1136)</description>
    <mitre>
      <id>T1136</id>
    </mitre>
    <group>account_created,himaltraders_persistence,</group>
  </rule>

  <!-- A member was added to a security group (4728 global, 4732 local, 4756 universal).
       Anchored on the win_group_changed rule group so it catches all group changes
       regardless of which built-in rule caught them (verified: 4732 -> rule 60154). -->
  <rule id="100006" level="8">
    <if_group>win_group_changed</if_group>
    <field name="win.system.eventID">^4728$|^4732$|^4756$</field>
    <description>HimalTraders: Member added to group $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName) (T1098)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>account_changed,himaltraders_persistence,</group>
  </rule>

  <!--
    Detection #3 - Office application spawning a shell (Sysmon Event 1)
    Threat model: Path 3 step 2 (malicious macro runs PowerShell). ATT&CK T1204.002 + T1059.001.
    Office apps have no legitimate reason to launch cmd/powershell/script hosts.
    Uses Sysmon process creation (Event 1): win.eventdata.parentImage + win.eventdata.image.
    Anchored on the sysmon_event1 rule group.
  -->
  <rule id="100003" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)(WINWORD|EXCEL|POWERPNT|OUTLOOK|MSACCESS|VISIO)\.EXE$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|regsvr32|rundll32)\.exe$</field>
    <description>HimalTraders: Office app ($(win.eventdata.parentImage)) spawned a shell ($(win.eventdata.image)) - possible malicious macro (T1204.002/T1059.001)</description>
    <mitre>
      <id>T1204.002</id>
      <id>T1059.001</id>
    </mitre>
    <group>himaltraders_phishing,malicious_macro,</group>
  </rule>

  <!-- HIGH severity: added to a privileged group (Domain Admins / Administrators / Enterprise Admins) -->
  <rule id="100007" level="13">
    <if_sid>100006</if_sid>
    <field name="win.eventdata.targetUserName">Domain Admins|Administrators|Enterprise Admins|Schema Admins</field>
    <description>HimalTraders: Account added to a PRIVILEGED group ($(win.eventdata.targetUserName)) - possible backdoor admin (T1098)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>account_changed,privilege_escalation,himaltraders_persistence,pci_dss_10.2.5,</group>
  </rule>

  <!--
    Detection #4 - LSASS credential theft, caught by Microsoft Defender
    Threat model: Path 1 step 3 / Path 3 step 4 (dump LSASS to steal AD credentials). ATT&CK T1003.001.
    Sysmon Event 10 (ProcessAccess) would not reliably log on this hardened host, but Defender's
    ASR rule "Block credential stealing from lsass.exe" catches and BLOCKS the attempt and logs it
    to the Microsoft-Windows-Windows Defender/Operational channel (onboarded via the agent ossec.conf).
    Built-in Wazuh rule 62123 already fires on a Defender detection (1116); we build on it to add
    Himal Traders context, then escalate when the threat is a credential-theft tool.
    This is a "control worked" / defense-in-depth detection: the attack was blocked AND recorded.
  -->

  <!-- Base: Defender detected/blocked any threat on an endpoint -->
  <rule id="100004" level="12">
    <if_sid>62123</if_sid>
    <description>HimalTraders: Microsoft Defender detected/blocked a threat on $(agent.name): $(win.eventdata.path)</description>
    <group>windows_defender,himaltraders_endpoint,</group>
  </rule>

  <!-- CRITICAL: the blocked threat is a credential-theft tool targeting LSASS.
       Matches the Defender threat name / command line in the raw event (e.g. HackTool:Win32/DumpLsass,
       Mimikatz, WDigest, Pwdump...). This is Himal Traders' crown-jewel detection: someone tried to
       steal domain credentials from DC01. -->
  <rule id="100008" level="13">
    <if_sid>100004</if_sid>
    <match type="pcre2">(?i)Lsass|Mimikatz|WDigest|Pwdump|Gsecdump|Samdump|DumpCreds|CredentialStealer</match>
    <description>HimalTraders: Defender BLOCKED a credential-theft attempt against LSASS on $(agent.name): $(win.eventdata.path) (T1003.001)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,himaltraders_crownjewel,pci_dss_10.2.5,</group>
  </rule>

  <!--
    Detection #2 - Successful brute force (failed logons THEN a success). T1110.
    Threat model: Path 1 step 1->2 (attacker guesses the password and gets in).
    Correlation: rule 100002 (brute force detected for a user) fired, then a successful
    logon (native rule 60106, event 4624) arrives for the SAME user within the timeframe.
    Grouped by targetUserName (not source IP), consistent with 100002, so it works for
    local and network logons alike. This is the high-severity OUTCOME of a brute force:
    a failed brute force is noise, a successful one is an incident.
  -->
  <rule id="100010" level="13" timeframe="600">
    <if_sid>60106</if_sid>
    <if_matched_sid>100002</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>HimalTraders: Successful logon for $(win.eventdata.targetUserName) right after a brute force - the attack likely SUCCEEDED (T1110)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_success,himaltraders_bruteforce,privilege_escalation,pci_dss_10.2.5,</group>
  </rule>

</group>
